---
---

<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie-Einwilligung"
  class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-500 ease-out"
>
  <div class="glass-strong border-t border-white/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex-1 max-w-3xl">
          <div class="flex items-center gap-2 mb-2">
            <i class="fas fa-cookie-bite text-primary text-base" aria-hidden="true"></i>
            <h3 class="text-base font-bold text-text-primary">Datenschutz-Einstellungen</h3>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Wir verwenden ausschließlich technisch notwendige Cookies, die für den Betrieb dieser Website erforderlich sind. 
            Externe Dienste (z. B. Analyse-Tools, eingebettete Inhalte) werden erst nach Ihrer ausdrücklichen Einwilligung geladen. 
            Sie können Ihre Entscheidung jederzeit widerrufen.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <button
            id="cookie-decline"
            type="button"
            class="px-5 py-2.5 text-sm font-medium text-text-secondary bg-white/40 hover:bg-white/60 rounded-full transition-colors duration-200"
          >
            Nur notwendige
          </button>
          <button
            id="cookie-accept"
            type="button"
            class="px-5 py-2.5 text-sm font-medium text-white bg-primary hover:bg-primary-dark rounded-full transition-colors duration-200 shadow-lg shadow-primary/20"
          >
            Alle akzeptieren
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const STORAGE_KEY = 'vsp_cookie_consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');

    if (!banner || !acceptBtn || !declineBtn) return;

    const consent = localStorage.getItem(STORAGE_KEY);

    if (!consent) {
      // Show banner with slight delay for better UX
      setTimeout(() => {
        banner.classList.remove('translate-y-full');
      }, 1000);
    }

    function setConsent(accepted: boolean) {
      const value = accepted ? 'accepted' : 'declined';
      localStorage.setItem(STORAGE_KEY, value);
      banner.classList.add('translate-y-full');
      
      // Dispatch custom event for other components to listen
      window.dispatchEvent(new CustomEvent('cookieConsentChanged', { 
        detail: { accepted } 
      }));
    }

    acceptBtn.addEventListener('click', () => setConsent(true));
    declineBtn.addEventListener('click', () => setConsent(false));
  })();
</script>
