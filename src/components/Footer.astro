---
import img1 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.14.jpeg';
import img2 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.24.jpeg';
import img3 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.30 (1).jpeg';
import img4 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.15 (1).jpeg';
import img5 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.34.jpeg';
import img6 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.26.jpeg';
import img7 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.31.jpeg';
import img8 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.33.jpeg';
import img9 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.35 (1).jpeg';
import img10 from '../assets/images/WhatsApp Image 2026-05-14 at 21.17.36 (1).jpeg';

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/ueber-uns', label: 'Über Uns' },
  { href: '/kontakt', label: 'Kontakt' },
];

const legalLinks = [
  { href: '/impressum', label: 'Impressum' },
  { href: '/datenschutz', label: 'Datenschutz' },
];

const galleryImages = [img1, img2, img3, img4, img5, img6, img7, img8, img9, img10];
---

<footer class="mt-auto relative overflow-hidden">
  {/* Decorative blobs for glass-dark visibility */}
  <div class="blob w-[600px] h-[600px] bg-primary/20 -top-40 -left-40 blob-animated-slow"></div>
  <div class="blob w-[500px] h-[500px] bg-primary/15 top-20 right-0 blob-animated-delayed"></div>

  {/* Bereich 1: Content-Grid */}
  <div class="relative z-10 bg-[#0d0d0d]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {/* Spalte 1: Brand */}
        <div class="glass-dark rounded-2xl p-6 sm:col-span-2 lg:col-span-1">
          <a href="/" class="inline-block text-2xl font-bold tracking-tight mb-4">
            Verteilservice <span class="text-primary">Plus</span>
          </a>
          <p class="text-gray-400 text-sm leading-relaxed mb-6 max-w-xs">
            Ihr zuverlässiger Partner für professionelle Flyerverteilung und Streetpromotion bundesweit in ganz Deutschland.
          </p>
          <a
            href="/kontakt"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 min-h-[44px]"
          >
            Jetzt Kontakt aufnehmen
          </a>
        </div>

        {/* Spalte 2: Navigation */}
        <div class="glass-dark rounded-2xl p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Navigation</h3>
          <ul class="space-y-3">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-primary transition-colors duration-200 text-sm min-h-[44px] flex items-center"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* Spalte 3: Rechtliches */}
        <div class="glass-dark rounded-2xl p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Rechtliches</h3>
          <ul class="space-y-3">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-primary transition-colors duration-200 text-sm min-h-[44px] flex items-center"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* Spalte 4: Kontakt */}
        <div class="glass-dark rounded-2xl p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Kontakt</h3>
          <ul class="space-y-4">
            <li>
              <a
                href="tel:+491638866766"
                class="inline-flex items-center gap-3 text-gray-400 hover:text-primary transition-colors duration-200 text-sm min-h-[44px]"
              >
                <i class="fas fa-phone text-xs shrink-0" aria-hidden="true"></i>
                <span>0163 8866766</span>
              </a>
            </li>
            <li>
              <a
                href="mailto:Info@verteilserviceplus.de"
                class="inline-flex items-center gap-3 text-gray-400 hover:text-primary transition-colors duration-200 text-sm break-all min-h-[44px]"
              >
                <i class="fas fa-envelope text-xs shrink-0" aria-hidden="true"></i>
                <span>Info@verteilserviceplus.de</span>
              </a>
            </li>
            <li>
              <a
                href="https://wa.me/491638866766"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 text-gray-400 hover:text-primary transition-colors duration-200 text-sm min-h-[44px]"
              >
                <i class="fab fa-whatsapp text-xs shrink-0" aria-hidden="true"></i>
                <span>WhatsApp</span>
              </a>
            </li>
            <li class="inline-flex items-start gap-3 text-gray-400 text-sm">
              <i class="fas fa-location-dot text-xs shrink-0 mt-0.5" aria-hidden="true"></i>
              <span>Kupferhammer weg 51<br />61440 Oberursel</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {/* Bereich 2: Auto-Galerie Marquee */}
  <div class="relative z-10 bg-[#0a0a0a] overflow-hidden py-4">
    <div class="relative flex w-[200%] animate-marquee">
      {/* Erste Reihe */}
      {galleryImages.map((src, i) => (
        <div class="shrink-0 w-64 h-44 mx-2 rounded-xl overflow-hidden opacity-60 hover:opacity-100 transition-opacity duration-300">
          <img
            src={src.src}
            alt=""
            class="w-full h-full object-cover"
            loading="lazy"
            width="256"
            height="176"
          />
        </div>
      ))}
      {/* Duplizierte Reihe für nahtloses Looping */}
      {galleryImages.map((src, i) => (
        <div class="shrink-0 w-64 h-44 mx-2 rounded-xl overflow-hidden opacity-60 hover:opacity-100 transition-opacity duration-300">
          <img
            src={src.src}
            alt=""
            class="w-full h-full object-cover"
            loading="lazy"
            width="256"
            height="176"
          />
        </div>
      ))}
    </div>
  </div>

  {/* Bereich 3: Copyright */}
  <div class="relative z-10 bg-black py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-gray-500 text-xs">
        &copy; {currentYear} Verteilservice Plus – Douaa Bendali. Alle Rechte vorbehalten.
      </p>
    </div>
  </div>
</footer>
