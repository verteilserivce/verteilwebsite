---
import { Image } from "astro:assets";
import logoImg from "../assets/logo.jpg";

const currentYear = new Date().getFullYear();
---

<footer class="bg-foreground text-white/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 mb-5" aria-label="Verteilservice Plus - Zur Startseite">
          <div class="bg-white rounded-xl p-1 shadow-lg shadow-black/20">
            <Image
              src={logoImg}
              alt="Verteilservice Plus Logo"
              width={36}
              height={48}
              class="h-9 w-auto rounded-md"
            />
          </div>
          <span class="font-serif text-lg font-semibold text-white tracking-tight">
            Verteilservice <span class="text-primary">Plus</span>
          </span>
        </a>
        <p class="text-sm leading-relaxed text-white/60 max-w-xs">
          Professionelle Flyerverteilung in Oberursel und Umgebung. Zuverlässig, transparent und persönlich.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-5">Navigation</h3>
        <ul class="space-y-3">
          <li><a href="/" class="text-sm hover:text-primary transition-colors duration-200">Startseite</a></li>
          <li><a href="/leistungen" class="text-sm hover:text-primary transition-colors duration-200">Leistungen</a></li>
          <li><a href="/ueber-uns" class="text-sm hover:text-primary transition-colors duration-200">Über Uns</a></li>
          <li><a href="/kontakt" class="text-sm hover:text-primary transition-colors duration-200">Kontakt</a></li>
        </ul>
      </div>

      <!-- Kontakt -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-5">Kontakt</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 text-primary shrink-0" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="text-sm">Kupferhammer weg 51<br>61440 Oberursel</span>
          </li>
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href="tel:+491638866766" class="text-sm hover:text-primary transition-colors duration-200">0163 8866766</a>
          </li>
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <a href="mailto:Info@verteilservice-plus.de" class="text-sm hover:text-primary transition-colors duration-200">Info@verteilservice-plus.de</a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-5">Rechtliches</h3>
        <ul class="space-y-3">
          <li><a href="/impressum" class="text-sm hover:text-primary transition-colors duration-200">Impressum</a></li>
          <li><a href="/datenschutz" class="text-sm hover:text-primary transition-colors duration-200">Datenschutz</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/40">
        © {currentYear} Verteilservice Plus - Douaa bendali. Alle Rechte vorbehalten.
      </p>
      <p class="text-xs text-white/40">
        Einzelunternehmen · Kupferhammer weg 51 · 61440 Oberursel
      </p>
    </div>
  </div>
</footer>
