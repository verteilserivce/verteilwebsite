---
interface Props {
  text: string;
  variant?: "default" | "light" | "outline";
}

const { text, variant = "default" } = Astro.props;

const variants = {
  default: "bg-primary/10 text-primary border-primary/20",
  light: "bg-white/20 text-white border-white/30",
  outline: "bg-transparent text-foreground border-border",
};
---

<span
  class={`inline-flex items-center px-4 py-1.5 rounded-full text-xs font-medium tracking-widest uppercase border ${variants[variant]}`}
>
  {text}
</span>
