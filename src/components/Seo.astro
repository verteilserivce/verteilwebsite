---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/og-image.jpg",
  canonicalUrl,
  noindex = false,
} = Astro.props;

const siteUrl = "https://verteilservice-plus.de";
const fullTitle = title.includes("Verteilservice Plus") 
  ? title 
  : `${title} | Verteilservice Plus`;
const fullCanonical = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Verteilservice Plus",
  description: description,
  url: siteUrl,
  telephone: "+491638866766",
  email: "Info@verteilservice-plus.de",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Kupferhammer weg 51",
    addressLocality: "Oberursel",
    postalCode: "61440",
    addressCountry: "DE",
  },
  founder: {
    "@type": "Person",
    name: "Douaa bendali",
  },
  priceRange: "€€",
  areaServed: {
    "@type": "City",
    name: "Oberursel",
  },
  serviceType: "Flyerverteilung",
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

<title>{fullTitle}</title>
<link rel="canonical" href={fullCanonical} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Verteilservice Plus" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:image" content={`${siteUrl}${ogImage}`} />
<meta property="og:locale" content="de_DE" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<!-- Theme Color -->
<meta name="theme-color" content="#1e938c" />
