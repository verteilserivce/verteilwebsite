---
import img1 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.15 (1).jpeg';
import img2 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.30.jpeg';
import img3 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.14.jpeg';
import img4 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.38.jpeg';
import img5 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.16.jpeg';
import img6 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.20.jpeg';
import img7 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.22.jpeg';
import img8 from '../../assets/images/WhatsApp Image 2026-05-14 at 21.17.27.jpeg';

const images = [img1, img2, img3, img4, img5, img6, img7, img8];
---

<section class="py-20 md:py-28 bg-white" aria-labelledby="gallery-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-4">Einblicke</span>
      <h2 id="gallery-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight">
        Hinter den Kulissen: Unser Team in Aktion.
      </h2>
    </div>

    {/* Scroll Container with Arrows */}
    <div class="relative">
      {/* Left Arrow */}
      <button
        type="button"
        id="gallery-prev"
        class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/80 backdrop-blur-md border border-white/50 shadow-lg text-text-primary flex items-center justify-center hover:text-primary transition-colors duration-200"
        aria-label="Vorheriges Bild"
      >
        <i class="fas fa-chevron-left text-sm" aria-hidden="true"></i>
      </button>

      {/* Right Arrow */}
      <button
        type="button"
        id="gallery-next"
        class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 z-10 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/80 backdrop-blur-md border border-white/50 shadow-lg text-text-primary flex items-center justify-center hover:text-primary transition-colors duration-200"
        aria-label="Nächstes Bild"
      >
        <i class="fas fa-chevron-right text-sm" aria-hidden="true"></i>
      </button>

      {/* Scroll Track */}
      <div
        id="gallery-track"
        class="flex gap-5 overflow-x-auto hide-scrollbar scroll-smooth snap-x snap-proximity px-4 md:px-10 py-4"
      >
        {images.map((img, i) => (
          <div class="shrink-0 snap-start w-[280px] md:w-[320px]">
            <div class="relative aspect-[3/4] rounded-3xl overflow-hidden group">
              <img
                src={img.src}
                alt={`Galeriebild ${i + 1}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width="320"
                height="427"
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* CTA */}
    <div class="text-center mt-10">
      <a
        href="/ueber-uns"
        class="group inline-flex items-center gap-2 px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5 min-h-[44px]"
      >
        Mehr Einblicke ansehen
        <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<script>
  (function() {
    const track = document.getElementById('gallery-track');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    if (!track || !prevBtn || !nextBtn) return;

    function getScrollAmount() {
      const card = track.querySelector(':scope > div');
      if (!card) return 340;
      const style = getComputedStyle(track);
      const gap = parseFloat(style.gap) || 20;
      return card.getBoundingClientRect().width + gap;
    }

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    // Touch swipe support
    let startX = 0;
    let isDown = false;

    track.addEventListener('touchstart', (e) => {
      isDown = true;
      startX = e.touches[0].pageX;
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      if (!isDown) return;
      isDown = false;
      const endX = e.changedTouches[0].pageX;
      const diff = startX - endX;
      if (Math.abs(diff) > 40) {
        track.scrollBy({ left: diff > 0 ? getScrollAmount() : -getScrollAmount(), behavior: 'smooth' });
      }
    }, { passive: true });
  })();
</script>
