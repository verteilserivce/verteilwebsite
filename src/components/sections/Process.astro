---
const steps = [
  {
    number: '1',
    title: 'Planung',
    description: 'Unsere Spezialisten planen jede Straße, jedes Haus und jedes Gebiet präzise.',
    icon: 'fa-clipboard-list',
  },
  {
    number: '2',
    title: 'Verteilung',
    description: 'Unsere geschulten Außendienst- und Verteilerteams setzen die Kampagne zuverlässig um.',
    icon: 'fa-person-walking',
  },
  {
    number: '3',
    title: 'Live-Kontrolle',
    description: 'Während der Verteilung läuft unser App-Tracking live und zeigt alle Standorte.',
    icon: 'fa-mobile-screen-button',
  },
  {
    number: '4',
    title: 'Qualitätsprüfung',
    description: 'Kontrolleure und Bezirksleiter prüfen zusätzlich jede laufende Aktion.',
    icon: 'fa-clipboard-check',
  },
];
---

<section class="relative py-20 md:py-28 overflow-hidden" aria-labelledby="process-heading">
  {/* Decorative blobs */}
  <div class="blob w-[450px] h-[450px] bg-primary/20 -top-20 -left-20 blob-animated"></div>
  <div class="blob w-[400px] h-[400px] bg-primary/15 bottom-0 right-0 blob-animated-delayed"></div>
  <div class="blob w-[300px] h-[300px] bg-primary/10 top-1/2 left-1/2 blob-animated-slow"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-4">Ablauf</span>
      <h2 id="process-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight">
        So arbeiten wir
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step) => (
        <div class="glass-strong rounded-3xl p-8 h-full">
          <div class="w-12 h-12 flex items-center justify-center rounded-full bg-primary text-white text-lg font-bold mb-6">
            <i class={`fas ${step.icon} text-sm`} aria-hidden="true"></i>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-3">{step.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
