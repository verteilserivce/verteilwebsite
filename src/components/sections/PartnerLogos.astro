---
import logo1 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_31PM.jpg';
import logo2 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_31PM (1).jpg';
import logo3 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_32PM.jpg';
import logo4 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_34PM.jpg';
import logo5 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_34PM (1).jpg';
import logo6 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_36PM.jpg';
import logo7 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_37PM.jpg';
import logo8 from '../../assets/partnerlogos/Generated Image May 14, 2026 - 9_39PM.jpg';

const partners = [logo1, logo2, logo3, logo4, logo5, logo6, logo7, logo8];
---

<section class="relative py-16 md:py-20 border-y border-border overflow-hidden" aria-label="Partner-Logos">
  {/* Decorative blobs */}
  <div class="blob w-[400px] h-[400px] bg-primary/5 top-1/2 left-0 -translate-y-1/2"></div>
  <div class="blob w-[400px] h-[400px] bg-primary/5 top-1/2 right-0 -translate-y-1/2"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <h2 class="text-center text-2xl md:text-3xl font-bold text-text-primary">
      Unsere Partner
    </h2>
  </div>

  <div class="relative z-10">
    {/* Fade edges */}
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

    {/* Marquee Track */}
    <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
      {/* First set */}
      {partners.map((logo) => (
        <div class="shrink-0 mx-10 flex items-center grayscale opacity-50 hover:grayscale-0 hover:opacity-100 active:grayscale-0 active:opacity-100 transition-all duration-300 cursor-default">
          <img
            src={logo.src}
            alt=""
            class="h-12 md:h-16 w-auto object-contain"
            loading="lazy"
            width="120"
            height="48"
          />
        </div>
      ))}
      {/* Duplicated set for seamless loop */}
      {partners.map((logo) => (
        <div class="shrink-0 mx-10 flex items-center grayscale opacity-50 hover:grayscale-0 hover:opacity-100 active:grayscale-0 active:opacity-100 transition-all duration-300 cursor-default">
          <img
            src={logo.src}
            alt=""
            class="h-12 md:h-16 w-auto object-contain"
            loading="lazy"
            width="120"
            height="48"
          />
        </div>
      ))}
    </div>
  </div>
</section>
