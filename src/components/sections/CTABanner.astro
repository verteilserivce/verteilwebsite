---
interface Props {
  title?: string;
  subtitle?: string;
  compact?: boolean;
  class?: string;
}

const {
  title = 'Bereit für Ihre nächste Kampagne?',
  subtitle = 'Gemeinsam sorgen wir für Sicherheit vor Ort – transparent, zuverlässig und messbar erfolgreich.',
  compact = false,
  class: className = '',
} = Astro.props;
---

<section class={`${compact ? 'py-5 md:py-8' : 'py-10 md:py-14'} ${className}`} aria-label="Call-to-Action">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-[#536c85] rounded-[2rem] p-8 md:p-10 lg:p-12">
      <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
        {/* Left: Icon + Text */}
        <div class="flex items-center gap-6 flex-1">
          {/* Paper Plane Icon */}
          <div class="w-16 h-16 md:w-20 md:h-20 shrink-0 rounded-full bg-white flex items-center justify-center">
            <i class="fas fa-paper-plane text-[#536c85] text-2xl md:text-3xl" aria-hidden="true"></i>
          </div>
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight">
              {title}
            </h2>
            <p class="mt-2 text-white/80 text-sm md:text-base leading-relaxed max-w-md">
              {subtitle}
            </p>
          </div>
        </div>

        {/* Right: Buttons */}
        <div class="flex flex-col gap-3 w-full lg:w-auto lg:min-w-[320px]">
          <a
            href="/kontakt#angebot"
            class="group inline-flex items-center justify-center gap-3 px-6 py-4 text-sm font-semibold text-white bg-white/20 hover:bg-white/30 rounded-xl transition-all duration-200 min-h-[52px]"
          >
            Jetzt unverbindliches Angebot anfordern
            <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
          <a
            href="https://wa.me/491638866766"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-6 py-4 text-sm font-semibold text-white border border-white/40 hover:bg-white/10 rounded-xl transition-all duration-200 min-h-[52px]"
          >
            <i class="fab fa-whatsapp text-lg" aria-hidden="true"></i>
            WhatsApp anfragen
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
