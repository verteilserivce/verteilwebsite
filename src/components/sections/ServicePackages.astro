---
const packages = [
  {
    name: 'Kompakt',
    description: 'Für kleine Kampagnen & Standardverteilung',
    features: [
      'Haus zu Haus Verteilung',
      'Prüfung der Verteilung',
      '24/7 Kundenservice',
      'Planung',
    ],
  },
  {
    name: 'Plus',
    description: 'Mehr Kontrolle & zusätzliche Leistungen',
    features: [
      'Haus zu Haus Verteilung',
      'Prüfung der Verteilung',
      '24/7 Kundenservice',
      'Planung',
      'GPS Live Standort Funktion',
      'Transport der Werbematerialien inklusive',
    ],
  },
  {
    name: 'Premium',
    description: 'Mit Apptracking & erweiterten Vorteilen',
    features: [
      'Haus zu Haus Verteilung',
      'Prüfung der Verteilung',
      '24/7 Kundenservice',
      'Planung',
      'GPS Live Standort Funktion',
      'Transport der Werbematerialien inklusive',
      'APP Tracking',
    ],
  },
  {
    name: 'Allrounder',
    description: 'Das Komplettpaket für maximale Sicherheit',
    features: [
      'Haus zu Haus Verteilung',
      'Prüfung der Verteilung',
      '24/7 Kundenservice',
      'Planung',
      'GPS Live Standort Funktion',
      'Transport der Werbematerialien inklusive',
      'APP Tracking',
      'Fotodokumentation der Verteilung',
    ],
  },
];
---

<section class="relative py-24 overflow-hidden" aria-labelledby="service-packages-heading">
  {/* Decorative blobs */}
  <div class="blob w-[500px] h-[500px] bg-primary/20 top-0 left-1/4 blob-animated"></div>
  <div class="blob w-[400px] h-[400px] bg-primary/15 bottom-0 right-1/4 blob-animated-delayed"></div>
  <div class="blob w-[350px] h-[350px] bg-primary/10 top-1/3 right-0 blob-animated-slow"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-4">Service-Pakete</span>
      <h2 id="service-packages-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight">
        Unsere Service-Pakete
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Wählen Sie das passende Paket für Ihre Kampagne – von der Basis-Verteilung bis zum Komplettservice.
      </p>
    </div>

    {/* Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {packages.map((pkg) => (
        <div class="glass-strong rounded-[2rem] overflow-hidden flex flex-col">
          {/* Content */}
          <div class="p-8 flex flex-col flex-1">
            <h3 class="text-2xl font-bold text-text-primary mb-2">{pkg.name}</h3>
            <p class="text-sm text-text-secondary mb-6">{pkg.description}</p>

            {/* Divider */}
            <div class="border-t border-white/30 mb-6"></div>

            {/* Feature List */}
            <div class="flex flex-col gap-3 mb-8 flex-1">
              {pkg.features.map((feature) => (
                <div class="flex items-start gap-3">
                  <i class="fas fa-check text-primary text-sm mt-0.5 shrink-0" aria-hidden="true"></i>
                  <span class="text-text-secondary text-sm">{feature}</span>
                </div>
              ))}
            </div>

            {/* CTA Button */}
            <div class="mt-auto">
              <a
                href="/kontakt#angebot"
                class="group inline-flex w-full items-center justify-center gap-2 rounded-full px-7 py-3 text-sm font-bold transition-all min-h-[44px] bg-primary text-white hover:bg-primary-dark"
              >
                Jetzt anfragen
                <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
