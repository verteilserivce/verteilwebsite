---
import aboutImage from '../../assets/images/überuns.jpeg';
import avatar1 from '../../assets/images/avatars/avatar1.png';
import avatar2 from '../../assets/images/avatars/avatar2.png';
import avatar3 from '../../assets/images/avatars/avatar3.png';
import avatar4 from '../../assets/images/avatars/avatar4.png';
import avatar5 from '../../assets/images/avatars/avatar5.png';

const topFeatures = [
  { icon: 'fa-paper-plane', title: 'Live-Tracking', subtitle: 'in Echtzeit' },
  { icon: 'fa-location-dot', title: 'GPS-Kontrolle', subtitle: '100% transparent' },
  { icon: 'fa-camera', title: 'Fotodokumentation', subtitle: 'Nachweise in Echtzeit' },
  { icon: 'fa-shield-halved', title: 'Qualitätskontrolle', subtitle: 'Durch eigene Teams' },
  { icon: 'fa-map-location-dot', title: 'Bundesweite Verteilung', subtitle: 'Überall in Deutschland' },
];

const checklist = [
  'Eigene, geschulte Verteiler & feste Teams',
  'Echte Nachweise durch Fotos',
  'Transparente Prozesse & volle Kontrolle',
  'Präzise Planung & regionale Auswahl',
];

const stats = [
  { icon: 'fa-calendar-days', value: '20+', label: 'Jahre Erfahrung' },
  { icon: 'fa-users', value: '100+', label: 'Verteiler im Einsatz' },
  { icon: 'fa-location-crosshairs', value: '1.000+', label: 'Städte in Deutschland' },
  { icon: 'fa-thumbs-up', value: '100%', label: 'Zufriedene Kunden' },
];

const avatars = [avatar1, avatar2, avatar3, avatar4, avatar5];
---

<section id="about-us" class="pt-10 md:pt-14 pb-16 md:pb-24 bg-white" aria-labelledby="about-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* ========== Top-Bar ========== */}
    <div class="bg-white border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.05)] rounded-2xl p-6 md:p-8 mb-8 md:mb-10">
      <div class="flex flex-wrap justify-center md:justify-between items-center gap-y-4 gap-x-6">
        {topFeatures.map((feat) => (
          <div class="flex items-center gap-3 min-w-[140px]">
            <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary shrink-0">
              <i class={`fas ${feat.icon} text-sm`} aria-hidden="true"></i>
            </span>
            <div>
              <p class="text-sm font-bold text-text-primary leading-tight">{feat.title}</p>
              <p class="text-xs text-text-muted">{feat.subtitle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ========== Main 3-Column Grid ========== */}
    <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_2.2fr_0.9fr] items-stretch gap-10">
      {/* ----- Left Column: Text & CTA ----- */}
      <div class="flex flex-col">
        <span class="text-xs font-bold uppercase tracking-widest text-accent mb-4">Über uns</span>
        <h2 id="about-heading" class="text-3xl md:text-4xl font-bold text-[#111827] leading-tight mb-2">
          Direkt. Persönlich.
        </h2>
        <p class="text-3xl md:text-4xl font-bold text-accent leading-tight mb-6">Erfolgreich.</p>

        <p class="text-[#4B5563] leading-relaxed mb-8">
          Haus-zu-Haus-Verteilung, Prospektverteilung und Streetpromotion mit echtem Qualitätsversprechen und Live-Tracking in Echtzeit.
        </p>

        <ul class="space-y-3 mb-8">
          {checklist.map((item) => (
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 flex items-center justify-center rounded-full bg-primary shrink-0 mt-0.5">
                <i class="fas fa-check text-[10px] text-white" aria-hidden="true"></i>
              </span>
              <span class="text-sm text-[#4B5563]">{item}</span>
            </li>
          ))}
        </ul>

        <a
          href="/ueber-uns"
          class="group inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-primary hover:bg-primary-dark rounded-lg transition-colors min-h-[44px] w-fit mb-8"
        >
          Mehr über uns
          <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
        </a>

        {/* Avatar Stack */}
        <div class="flex flex-col items-start gap-2 mt-auto">
          <div class="flex -space-x-3">
            {avatars.map((src, index) => (
              <img
                src={src.src}
                alt={`Teammitglied ${index + 1}`}
                class="w-9 h-9 rounded-full border-2 border-white object-cover bg-gray-200"
                loading="lazy"
                width="36"
                height="36"
              />
            ))}
            <div class="w-9 h-9 rounded-full bg-green-500 border-2 border-white flex items-center justify-center text-white text-xs shrink-0 relative z-10">
              <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
            </div>
          </div>
          <p class="text-sm text-[#4B5563]">
            <span class="font-bold text-[#111827]">100+</span> Verteiler im Einsatz für Sie
          </p>
        </div>
      </div>

      {/* ----- Middle Column: Bento 2×2 Grid ----- */}
      <div class="grid grid-cols-2 grid-rows-2 h-full gap-4">
        {/* Box 1: Live-Tracking */}
        <div class="bg-gray-50 border border-gray-100 rounded-2xl shadow-sm overflow-hidden flex flex-col justify-between p-5">
          <div>
            <p class="text-sm font-bold text-text-primary">Live-Tracking</p>
            <p class="text-xs text-text-muted">in Echtzeit</p>
          </div>
          <svg viewBox="0 0 200 60" class="w-full h-12 mt-2 text-primary" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="0,50 40,35 80,42 120,20 160,28 200,10" />
            <circle cx="40" cy="35" r="3" fill="currentColor" />
            <circle cx="80" cy="42" r="3" fill="currentColor" />
            <circle cx="120" cy="20" r="3" fill="currentColor" />
            <circle cx="160" cy="28" r="3" fill="currentColor" />
            <circle cx="200" cy="10" r="3" fill="currentColor" />
          </svg>
        </div>

        {/* Box 2: Fotodokumentation */}
        <div class="bg-gray-50 border border-gray-100 rounded-2xl shadow-sm overflow-hidden flex flex-col justify-between p-5">
          <div>
            <p class="text-sm font-bold text-text-primary">Fotodokumentation</p>
            <p class="text-xs text-text-muted">Nachweise in Echtzeit</p>
          </div>
          <div class="flex items-end justify-end">
            <svg class="w-12 h-12 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
          </div>
        </div>

        {/* Box 3: Foto */}
        <div class="bg-gray-50 border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
          <img
            src={aboutImage.src}
            alt="Team bei der professionellen Flyerverteilung"
            class="w-full h-full object-cover"
            loading="lazy"
            width="400"
            height="300"
          />
        </div>

        {/* Box 4: GPS-Kontrolle */}
        <div class="bg-gray-50 border border-gray-100 rounded-2xl shadow-sm overflow-hidden flex flex-col justify-between p-5">
          <div>
            <p class="text-sm font-bold text-text-primary">GPS-Kontrolle</p>
            <p class="text-xs text-text-muted">100% transparent</p>
          </div>
          <div class="flex items-end justify-end">
            <svg class="w-12 h-12 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
        </div>
      </div>

      {/* ----- Right Column: Stats ----- */}
      <div class="flex flex-col h-full justify-between">
        {stats.map((stat) => (
          <div class="flex items-center gap-5">
            <i class={`fas ${stat.icon} text-primary text-3xl shrink-0`} aria-hidden="true"></i>
            <div>
              <p class="text-4xl font-bold text-[#111827]">{stat.value}</p>
              <p class="text-xs text-text-muted">{stat.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
