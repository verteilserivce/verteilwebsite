---
import ArrowRight from '../icons/ArrowRight.astro';
import Bullseye from '../icons/Bullseye.astro';
import ShieldCheck from '../icons/ShieldCheck.astro';
import aboutLarge from '../../assets/images/überuns.jpeg';
import aboutSmall1 from '../../assets/images/überuns2.jpeg';
import aboutSmall2 from '../../assets/images/warumwir.jpeg';
---

<section class="py-20 md:py-28 bg-white" aria-labelledby="about-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Left Column */}
      <div class="order-2 lg:order-1">
        <span class="inline-block px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-primary bg-primary/5 rounded-full mb-6">
          Über Uns
        </span>
        <h2 id="about-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight mb-6">
          Seit über 20 Jahren Ihr Partner für professionelle Werbeverteilung.
        </h2>
        <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-8">
          Wir stehen für professionelle, zuverlässige und messbare Haus-zu-Haus-Verteilung sowie Streetpromotion – 
          bundesweit in ganz Deutschland. Unser Team aus erfahrenen Spezialisten im Innen- und Außendienst 
          plant und setzt jeden Auftrag präzise um.
        </p>

        {/* Features */}
        <ul class="space-y-4 mb-10">
          <li class="flex items-start gap-4">
            <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary shrink-0 mt-0.5">
              <Bullseye class="w-5 h-5" />
            </span>
            <div>
              <h3 class="text-base font-semibold text-text-primary mb-1">Präzise Planung bis zur letzten Straße</h3>
              <p class="text-sm text-text-secondary">Jede Kampagne wird so detailliert geplant, dass jedes Haus und jedes Verteilgebiet exakt berücksichtigt wird.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary shrink-0 mt-0.5">
              <ShieldCheck class="w-5 h-5" />
            </span>
            <div>
              <h3 class="text-base font-semibold text-text-primary mb-1">Exzellente Ausführung & maximale Kontrolle</h3>
              <p class="text-sm text-text-secondary">Mit Live-App-Tracking, Fotodokumentation und eigenen Kontrolleuren garantieren wir höchste Qualität.</p>
            </div>
          </li>
        </ul>

        {/* Footer Action */}
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
          <a
            href="/ueber-uns"
            class="group inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 min-h-[44px]"
          >
            Mehr erfahren
            <ArrowRight class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
          </a>

          <div>
            <p class="text-sm font-semibold text-text-primary">Douaa Bendali</p>
            <p class="text-xs text-text-muted">Inhaber</p>
          </div>
        </div>
      </div>

      {/* Right Column: Image Collage */}
      <div class="order-1 lg:order-2 relative h-[500px] md:h-[650px]">
        {/* Large Image Right */}
        <div class="absolute right-0 top-0 w-[70%] h-full rounded-2xl overflow-hidden shadow-2xl">
          <img
            src={aboutLarge.src}
            alt="Team bei der Arbeit"
            class="w-full h-full object-cover"
            loading="eager"
            width="560"
            height="650"
          />
        </div>
        {/* Small Image Top-Left */}
        <div class="absolute left-0 top-8 w-[55%] h-[45%] rounded-2xl overflow-hidden shadow-xl border-8 border-white z-10">
          <img
            src={aboutSmall1.src}
            alt="Verteilung in der Stadt"
            class="w-full h-full object-cover"
            loading="eager"
            width="330"
            height="293"
          />
        </div>
        {/* Small Image Bottom-Left */}
        <div class="absolute left-4 bottom-8 w-[50%] h-[40%] rounded-2xl overflow-hidden shadow-xl border-8 border-white z-20">
          <img
            src={aboutSmall2.src}
            alt="Qualitätskontrolle"
            class="w-full h-full object-cover"
            loading="eager"
            width="300"
            height="260"
          />
        </div>
      </div>
    </div>
  </div>
</section>
