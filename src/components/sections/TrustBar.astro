---
const trustItems = [
  { label: 'Über 20 Jahre Erfahrung', icon: 'fa-clock' },
  { label: 'Bundesweite Teams', icon: 'fa-users' },
  { label: '100 % Haus-zu-Haus-Fokus', icon: 'fa-house' },
  { label: 'Live-Tracking', icon: 'fa-satellite-dish' },
  { label: 'Fotodokumentation', icon: 'fa-camera' },
  { label: 'Eigene Kontrolleure', icon: 'fa-user-shield' },
  { label: 'Bezirksleiter-Prüfung', icon: 'fa-clipboard-check' },
  { label: 'Marktführer als Kunden', icon: 'fa-trophy' },
];
---

<section class="bg-white border-y border-border" aria-label="Vertrauensindikatoren">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-3">
      {trustItems.map((item) => (
        <div class="flex items-center gap-2 text-sm font-medium text-text-secondary">
          <i class={`fas ${item.icon} text-primary text-xs shrink-0`} aria-hidden="true"></i>
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
