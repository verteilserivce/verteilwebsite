---
import Check from '../icons/Check.astro';
import trackingImg from '../../assets/images/livetracking.jpg';

const features = [
  'Eigene Tracking-App',
  'Live-Standorte',
  'Rote Straßenmarkierung',
  'Fotodokumentation',
  'Kontrolleure',
  'Bezirksleiter',
  'Abschlussreport',
];
---

<section class="py-20 md:py-28 bg-white" aria-labelledby="tracking-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Left: Content */}
      <div>
        <span class="inline-block text-sm font-bold uppercase tracking-widest text-primary mb-4">Qualität</span>
        <h2 id="tracking-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight mb-6">
          Live Tracking & Qualität
        </h2>
        <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-8">
          Mit unserer eigenen Tracking-App behalten Sie jederzeit den Überblick. 
          Jede Straße wird dokumentiert, jeder Standort erfasst – für maximale Transparenz 
          und lückenlose Qualitätskontrolle.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {features.map((feature) => (
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 flex items-center justify-center rounded-full bg-green-100 text-green-600 shrink-0">
                <Check class="w-3.5 h-3.5" />
              </span>
              <span class="text-sm text-text-secondary font-medium">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      {/* Right: Visual */}
      <div class="relative">
        <div class="aspect-[4/3] rounded-[2rem] overflow-hidden bg-gray-100">
          <img
            src={trackingImg.src}
            alt="Live-Tracking-App mit GPS-Standortkontrolle"
            class="w-full h-full object-cover"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
        {/* Decorative element */}
        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-primary/10 rounded-full -z-10"></div>
        <div class="absolute -top-4 -left-4 w-16 h-16 bg-primary/5 rounded-full -z-10"></div>
      </div>
    </div>
  </div>
</section>
