---
import ArrowRight from '../icons/ArrowRight.astro';
import hero1 from '../../assets/images/hero1.jpeg';
import hero2 from '../../assets/images/hero2.jpg';
---

<section class="relative min-h-screen flex items-center overflow-hidden" aria-label="Hero-Bereich">
  {/* Background Slider */}
  <div class="absolute inset-0 z-0">
    <div id="hero-slider" class="relative w-full h-full">
      <img
        src={hero1.src}
        alt=""
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-100"
        fetchpriority="high"
        aria-hidden="true"
      />
      <img
        src={hero2.src}
        alt=""
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-0"
        loading="lazy"
        aria-hidden="true"
      />
    </div>
    {/* Dark Overlay */}
    <div class="absolute inset-0 bg-black/60 z-[1]"></div>
  </div>

  {/* Abstract SVG Decorations */}
  <svg class="absolute top-0 left-0 w-64 md:w-96 h-64 md:h-96 text-white/10 z-[2] pointer-events-none" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M-50 100 Q80 50 150 150 T350 50" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/>
    <path d="M-30 180 Q100 120 200 220 T380 120" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
    <path d="M-10 260 Q120 200 250 300 T400 200" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4"/>
  </svg>
  <svg class="absolute bottom-0 right-0 w-64 md:w-96 h-64 md:h-96 text-white/10 z-[2] pointer-events-none" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M450 300 Q320 350 250 250 T50 350" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/>
    <path d="M430 220 Q300 280 200 180 T20 280" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
    <path d="M410 140 Q280 200 150 100 T0 200" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4"/>
  </svg>

  {/* Content */}
  <div class="relative z-[3] max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-32">
    <div class="max-w-3xl">
      <span class="inline-block text-sm md:text-base font-bold uppercase tracking-widest text-primary mb-6">
        Bundesweit seit über 20 Jahren
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] mb-8">
        Flyerverteilung,<br />
        Prospektverteilung<br />
        <span class="font-serif italic">& Streetpromotion</span>
      </h1>
      <p class="text-lg md:text-xl text-white/80 max-w-xl mb-10 leading-relaxed">
        Professionelle Haus-zu-Haus-Verteilung mit Live-App-Tracking, Fotodokumentation und eigener Qualitätskontrolle.
      </p>

      <div class="flex flex-col sm:flex-row items-start gap-5">
        {/* Primary Button */}
        <a
          href="/kontakt"
          class="group inline-flex items-center gap-3 px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-300 shadow-xl shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5"
        >
          Jetzt unverbindliches Angebot anfragen
          <ArrowRight class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
        </a>

        {/* Secondary WhatsApp */}
        <a
          href="https://wa.me/491638866766"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 text-white hover:text-white/90 transition-colors duration-200"
        >
          <span class="w-12 h-12 flex items-center justify-center rounded-full border-2 border-white/40 group-hover:border-white transition-colors duration-300">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
            </svg>
          </span>
          <span class="text-sm font-medium underline underline-offset-4 decoration-white/30 hover:decoration-white/60">
            Direkt über WhatsApp anfragen
          </span>
        </a>
      </div>
    </div>
  </div>

  {/* Scroll Indicator */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-[3] hidden md:flex flex-col items-center gap-2 motion-safe:animate-bounce">
    <span class="text-white/50 text-xs uppercase tracking-widest">Scroll</span>
    <svg class="w-5 h-5 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<script>
  (function() {
    const slider = document.getElementById('hero-slider');
    if (!slider) return;
    const slides = slider.children;
    let current = 0;
    let intervalId = null;

    function cycle() {
      slides[current].classList.remove('opacity-100');
      slides[current].classList.add('opacity-0');
      current = (current + 1) % slides.length;
      slides[current].classList.remove('opacity-0');
      slides[current].classList.add('opacity-100');
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (!intervalId) intervalId = setInterval(cycle, 5000);
        } else {
          if (intervalId) {
            clearInterval(intervalId);
            intervalId = null;
          }
        }
      });
    }, { threshold: 0.1 });

    observer.observe(slider);
  })();
</script>
