---
const packages = [
  {
    name: 'Starter Vorteil',
    subtitle: 'Ab 50.000 Flyer',
    icon: 'fa-rocket',
    features: ['Kostenlose Lagerung', 'Verteilplanung inklusive', 'Basis-Support'],
  },
  {
    name: 'Premium Vorteil',
    subtitle: 'Ab 100.000 Flyer',
    icon: 'fa-star',
    features: ['App-Tracking inklusive', 'Live-Standorte', 'Kostenlose Lagerung', 'Priorisierte Verteilung'],
  },
  {
    name: 'Business Vorteil',
    subtitle: 'Ab 250.000 Flyer',
    icon: 'fa-gem',
    features: ['Fotodokumentation inklusive', 'Bezirksleiter-Kontrolle', 'GPS-Live-Überwachung', 'Express-Abwicklung'],
  },
  {
    name: 'Mega Deal',
    subtitle: 'Ab 500.000 Flyer + 25.000 gratis',
    icon: 'fa-crown',
    highlighted: true,
    features: ['Alle Business-Vorteile', '+ 25.000 Flyer kostenlos', 'Live-App-Tracking', 'GPS-Standortkontrolle'],
  },
];
---

<section class="py-16 md:py-20 section-glass-bg" aria-labelledby="pricing-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-3">Vorteile</span>
      <h2 id="pricing-heading" class="text-3xl md:text-4xl font-bold text-text-primary">
        Ihre Vorteile nach Auflagenhöhe
      </h2>
      <p class="mt-3 text-text-secondary max-w-xl mx-auto">
        Je höher die Auflage, desto mehr Vorteile sichern Sie sich – transparent und ohne versteckte Kosten.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {packages.map((pkg) => (
        <div class={`relative rounded-[2rem] overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-1 ${pkg.highlighted ? 'ring-2 ring-primary shadow-xl shadow-primary/15' : 'glass-strong'}`}>
          {pkg.highlighted && (
            <div class="absolute top-0 left-0 right-0 bg-primary text-white text-xs font-bold text-center py-1.5 uppercase tracking-wider">
              Beliebt
            </div>
          )}
          <div class={`p-6 flex flex-col flex-1 ${pkg.highlighted ? 'pt-10' : ''}`}>
            <div class={`w-12 h-12 flex items-center justify-center rounded-2xl mb-5 ${pkg.highlighted ? 'bg-primary text-white' : 'bg-primary/10 text-primary'}`}>
              <i class={`fas ${pkg.icon} text-lg`} aria-hidden="true"></i>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-1">{pkg.name}</h3>
            <p class="text-sm text-text-muted mb-5">{pkg.subtitle}</p>

            <div class="border-t border-white/30 mb-5"></div>

            <ul class="space-y-3 flex-1">
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <i class="fas fa-check text-primary text-xs mt-1 shrink-0" aria-hidden="true"></i>
                  <span class="text-sm text-text-secondary">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/kontakt#angebot"
        class="inline-flex items-center gap-2 px-8 py-3.5 text-sm font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5 min-h-[44px]"
      >
        Individuelles Angebot anfragen
        <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
