---
const packages = [
  {
    name: 'Starter Vorteil',
    subtitle: 'Ab 50.000 Flyer',
    features: ['Kostenlose Lagerung', 'Verteilplanung inklusive', 'Basis-Support'],
  },
  {
    name: 'Premium Vorteil',
    subtitle: 'Ab 100.000 Flyer',
    features: ['App-Tracking inklusive', 'Live-Standorte', 'Kostenlose Lagerung', 'Priorisierte Verteilung'],
  },
  {
    name: 'Business Vorteil',
    subtitle: 'Ab 250.000 Flyer',
    features: ['Fotodokumentation inklusive', 'Bezirksleiter-Kontrolle', 'GPS-Live-Überwachung', 'Express-Abwicklung'],
  },
  {
    name: 'Mega Deal',
    subtitle: 'Ab 500.000 Flyer + 25.000 gratis',
    features: ['Alle Business-Vorteile', '+ 25.000 Flyer kostenlos', 'Live-App-Tracking', 'GPS-Standortkontrolle'],
  },
];
---

<section class="py-10 md:py-14 bg-background-alt" aria-labelledby="pricing-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 id="pricing-heading" class="text-lg md:text-xl font-semibold text-text-primary">
        Ihre Vorteile nach Auflagenhöhe
      </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {packages.map((pkg) => (
        <div class="bg-white rounded-xl border border-gray-100 p-4 md:p-5 text-center transition-colors hover:border-primary/20">
          <p class="text-sm font-bold text-primary">{pkg.name}</p>
          <p class="text-[11px] text-text-muted mt-0.5 mb-3">{pkg.subtitle}</p>
          <ul class="space-y-1 text-left">
            {pkg.features.map((feature) => (
              <li class="flex items-start gap-2 text-xs text-text-secondary">
                <i class="fas fa-check text-primary text-[10px] mt-0.5 shrink-0" aria-hidden="true"></i>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-6 text-center">
      <a
        href="/kontakt#angebot"
        class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-dark transition-colors min-h-[44px] px-4"
      >
        Individuelles Angebot anfragen
        <i class="fas fa-arrow-right text-xs" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
