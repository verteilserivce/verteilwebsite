---
import Layout from '../layouts/Layout.astro';
import leistung1 from '../assets/images/leistung1.jpg';
import leistung2 from '../assets/images/leistung2.jpg';
import leistung3 from '../assets/images/leistung3.jpg';
import leistung4 from '../assets/images/leistung4.jpg';
import leistung5 from '../assets/images/leistung5.jpg';
import leistung6 from '../assets/images/leistung6.jpg';
import leistung7 from '../assets/images/leistung7.jpg';
import leistung8 from '../assets/images/leistung8.jpg';
import leistung9 from '../assets/images/leistung9.jpg';

const services = [
  {
    title: 'Flyerverteilung',
    subtitle: 'Die klassische Direktwerbung',
    description: 'Zuverlässige Haus-zu-Haus-Verteilung mit präziser Gebietsplanung bis auf Straßen- und Hausebene. Wir bringen Ihre Flyer professionell in die Briefkästen Ihrer Zielgruppe – bundesweit in ganz Deutschland.',
    features: [
      'Zielgenaue Routenplanung nach PLZ oder Stadtteil',
      'Termingerechte Auslieferung mit Qualitätskontrolle',
      'Einzelflyer-Verteilung (keine Mehrfachbelegung)',
      'Fotodokumentation und GPS-Tracking auf Wunsch',
      'Unbegrenzte Auflagen – wir verteilen so viel Sie benötigen',
    ],
    highlighted: true,
    image: leistung1,
    icon: 'fa-paper-plane',
  },
  {
    title: 'Prospektverteilung',
    subtitle: 'Ideal für große Marken und Franchises',
    description: 'Ideal für lokale Geschäfte, Filialen, Franchises und große Marken mit messbarer Reichweite. Wir planen und führen Ihre Prospektverteilung mit höchster Präzision durch.',
    features: [
      'Massgeschneiderte Gebietsplanung',
      'Koordination mit Filialnetzwerken',
      'Mengenplanung und Tourenoptimierung',
      'Live-Tracking während der Verteilung',
      'Detaillierte Abschlussreports',
    ],
    highlighted: false,
    image: leistung2,
    icon: 'fa-newspaper',
  },
  {
    title: 'Zeitungs- & Beilagenverteilung',
    subtitle: 'Regelmäßige Präsenz für Ihre Marke',
    description: 'Gezielte Zustellung von Werbebeilagen, Wochenblättern und regionalen Prospekten. Wir garantieren pünktliche und flächendeckende Abdeckung in Ihrem Wunschgebiet.',
    features: [
      'Wöchentliche, monatliche oder einmalige Verteilung',
      'Garantierte Zustellung bis zu einem festen Termin',
      'Flächendeckende Abdeckung bundesweit',
      'Erfahrene Verteiler mit regionaler Ortskenntnis',
      'Rückmeldung bei Nichtzustellbarkeit',
    ],
    highlighted: false,
    image: leistung3,
    icon: 'fa-layer-group',
  },
  {
    title: 'Direktwerbung',
    subtitle: 'Individuelle Werbemittel gezielt platziert',
    description: 'Verteilung individueller Werbemittel direkt in Briefkästen Ihrer Zielgruppe. Perfekt für exklusive Angebote, Einladungen und hochwertige Direktwerbung.',
    features: [
      'Gezielte Ansprache nach Zielgruppe',
      'Ideal für Einladungen und Premium-Angebote',
      'Hohe Aufmerksamkeit durch persönlichen Charakter',
      'Enge Zusammenarbeit bei der Gebietsauswahl',
      'Datenschutzkonforme Handhabung',
    ],
    highlighted: false,
    image: leistung4,
    icon: 'fa-bullhorn',
  },
  {
    title: 'Streetpromotion',
    subtitle: 'Ihre Marke live vor Ort',
    description: 'Promotion-Teams für Innenstädte, Einkaufszonen, Events, Messen und stark frequentierte Bereiche. Wir bringen Ihre Marke direkt zu den Menschen.',
    features: [
      'Flyer-Handouts an stark frequentierten Orten',
      'Produktproben-Verteilung bei Events',
      'Persönliche Ansprache und Interaktion',
      'Flexible Einsatzzeiten und Standorte',
      'Erfahrene Promoter mit Freundlichkeit und Engagement',
    ],
    highlighted: false,
    image: leistung5,
    icon: 'fa-users',
  },
  {
    title: 'Wahlwerbung',
    subtitle: 'Gezielte politische Werbeverteilung',
    description: 'Professionelle Verteilung von Wahlwerbematerial für Parteien, Kandidaten und politische Kampagnen. Wir sorgen für eine breite und zielgenaue Reichweite in Ihrem Wahlgebiet.',
    features: [
      'Gezielte Verteilung in Wahlbezirken und Stadtteilen',
      'Termingerechte Auslieferung vor Wahltagen',
      'Koordination mit lokalen Teams und Helfern',
      'Dokumentation der verteilten Gebiete',
      'Erfahrung mit politischen Kampagnen',
    ],
    highlighted: false,
    image: leistung6,
    icon: 'fa-check-to-slot',
  },
  {
    title: 'Bundesweite Kampagnenplanung',
    subtitle: 'Von der Idee bis zur Umsetzung',
    description: 'Von der Mengenplanung über Zielgebiete bis zur exakten Touren- und Bezirksstruktur. Wir planen Ihre bundesweite Kampagne bis ins kleinste Detail.',
    features: [
      'Detaillierte Gebiets- und Straßenplanung',
      'Mengenplanung und Logistikkoordination',
      'Exakte Touren- und Bezirksstruktur',
      'Koordination bundesweiter Teams',
      'Umfassende Abschlussreports',
    ],
    highlighted: false,
    image: leistung7,
    icon: 'fa-map-location-dot',
  },
  {
    title: 'Adressierte Verteilung',
    subtitle: 'Personalisierter Versand an Ihre Zielgruppe',
    description: 'Gezielte Zustellung Ihrer Werbung direkt an ausgewählte Haushalte und Unternehmen. Perfekt für exklusive Einladungen, VIP-Angebote und Neukundenakquise.',
    features: [
      'Gezielte Ansprache nach Adressliste oder Zielgruppe',
      'Ideal für Einladungen, Angebote und Kundenmailings',
      'Hohe Aufmerksamkeit durch personalisierten Charakter',
      'Enge Zusammenarbeit bei der Adressauswahl',
      'Datenschutzkonforme Handhabung aller Adressdaten',
    ],
    highlighted: false,
    image: leistung8,
    icon: 'fa-address-book',
  },
  {
    title: 'Web- & Logo Design',
    subtitle: 'Ihr professioneller Auftritt im Netz',
    description: 'Moderne Webseiten und professionelle Logos für einen starken und überzeugenden Markenauftritt. Wir gestalten visuelle Identitäten, die im Gedächtnis bleiben.',
    features: [
      'Individuelles Logo-Design und Corporate Design',
      'Responsive Webdesign für alle Endgeräte',
      'SEO-optimierte Struktur für bessere Auffindbarkeit',
      'Klare Call-to-Actions für höhere Conversion',
      'Betreuung und Wartung nach Go-Live',
    ],
    highlighted: false,
    image: leistung9,
    icon: 'fa-pen-ruler',
  },
];

const benefits = [
  'Exakte Haus-zu-Haus-Planung',
  'Bundesweite Teams',
  'Live-App-Tracking',
  'Standortkontrolle',
  'Fotodokumentation jeder Straße',
  'Qualitätskontrolle durch eigene Kontrolleure',
  'Bezirksleiter-Überwachung',
  'Abschlussreport auf Wunsch',
];

const audiences = [
  'lokale Unternehmen',
  'Filialisten',
  'Franchises',
  'große Marken',
  'Marktführer',
  'Neueröffnungen',
  'Rabattaktionen',
  'Event- und Messewerbung',
];
---

<Layout
  title="Leistungen | Verteilservice Plus"
  description="Unsere Leistungen: Flyerverteilung, Prospektverteilung, Zeitungsverteilung, Direktwerbung, Streetpromotion, Sampling, Kampagnenplanung, Adressierte Verteilung und Web- & Logo Design bundesweit."
>
  <main>
    {/* Hero */}
    <section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
      <div class="blob w-[600px] h-[600px] bg-primary/20 top-0 left-1/2 -translate-x-1/2 blob-animated"></div>
      <div class="blob w-[400px] h-[400px] bg-primary/15 bottom-0 left-1/4 blob-animated-delayed"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-4">Unsere Leistungen</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-6 leading-tight">
            Professionelle Werbeverteilung & Promotion bundesweit
          </h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
            Seit über 20 Jahren bieten wir bundesweit professionelle Lösungen rund um Werbeverteilung und Promotion – mit Live-Tracking, Fotodokumentation und eigener Qualitätskontrolle.
          </p>
        </div>
      </div>
    </section>

    {/* Services Detail */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-20 md:space-y-28">
          {services.map((service, index) => (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
              <div class={index % 2 === 1 ? 'lg:order-2' : ''}>
                <div class="glass rounded-3xl p-8">
                  <span class={`inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest mb-3 ${service.highlighted ? 'text-primary' : 'text-text-muted'}`}>
                    <i class={`fas ${service.icon} text-[10px]`} aria-hidden="true"></i>
                    {service.subtitle}
                  </span>
                  <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-text-primary mb-4">
                    {service.title}
                  </h2>
                  <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-8">
                    {service.description}
                  </p>
                  <ul class="space-y-3 mb-8">
                    {service.features.map((feature) => (
                      <li class="flex items-start gap-3">
                        <span class="w-5 h-5 flex items-center justify-center rounded-full bg-green-100 text-green-600 shrink-0 mt-0.5">
                          <i class="fas fa-check text-[10px]" aria-hidden="true"></i>
                        </span>
                        <span class="text-sm text-text-secondary">{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <a
                    href="/kontakt#angebot"
                    class={`group inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold rounded-full transition-all duration-200 ${
                      service.highlighted
                        ? 'text-white bg-primary hover:bg-primary-dark shadow-lg shadow-primary/20'
                        : 'text-white bg-primary hover:bg-primary-dark'
                    }`}
                  >
                    Jetzt anfragen
                    <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
                  </a>
                </div>
              </div>
              <div class={`${index % 2 === 1 ? 'lg:order-1' : ''}`}>
                <div class={`aspect-[4/3] rounded-3xl overflow-hidden ${service.highlighted ? 'ring-2 ring-primary' : ''}`}>
                  <img
                    src={service.image.src}
                    alt={service.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    width="600"
                    height="450"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Benefits */}
    <section class="relative py-20 md:py-28 overflow-hidden">
      <div class="blob w-[500px] h-[500px] bg-primary/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 blob-animated"></div>
      <div class="blob w-[400px] h-[400px] bg-primary/15 top-0 right-0 blob-animated-delayed"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-4">Inklusive</span>
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary">
            Was Sie bei jeder Leistung erhalten
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
          {benefits.map((benefit) => (
            <div class="glass rounded-2xl px-5 py-4">
              <span class="flex items-center gap-3">
                <span class="w-6 h-6 flex items-center justify-center rounded-full bg-green-100 text-green-600 shrink-0">
                  <i class="fas fa-check text-[10px]" aria-hidden="true"></i>
                </span>
                <span class="text-sm font-medium text-text-secondary">{benefit}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Target Audience */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="inline-block text-sm font-bold uppercase tracking-widest text-accent mb-4">Zielgruppen</span>
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary">
            Für wen unsere Leistungen ideal sind
          </h2>
        </div>
        <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
          {audiences.map((audience) => (
            <span class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-text-secondary glass rounded-full">
              <i class="fas fa-user-check text-primary text-[10px]" aria-hidden="true"></i>
              {audience}
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="relative py-20 md:py-28 overflow-hidden">
      <div class="blob w-[500px] h-[500px] bg-primary/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 blob-animated"></div>
      <div class="blob w-[400px] h-[400px] bg-primary/15 top-0 left-0 blob-animated-delayed"></div>
      <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-strong rounded-3xl p-10 md:p-14 text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Nicht sicher, welche Leistung die richtige ist?
          </h2>
          <p class="text-lg text-text-secondary mb-8">
            Kontaktieren Sie uns unverbindlich. Wir beraten Sie persönlich und finden gemeinsam die optimale Lösung für Ihr Werbeziel.
          </p>
          <a
            href="/kontakt#angebot"
            class="group inline-flex items-center gap-2 px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5"
          >
            Kostenloses Beratungsgespräch vereinbaren
            <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
