---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Seite nicht gefunden | Verteilservice Plus"
  description="Die angeforderte Seite konnte nicht gefunden werden."
>
  <main class="flex-1 flex items-center justify-center pt-20 pb-16">
    <div class="glass-strong rounded-3xl p-10 md:p-16 text-center max-w-xl mx-auto px-4 sm:px-6">
      <i class="fas fa-triangle-exclamation text-primary text-5xl mb-6" aria-hidden="true"></i>
      <h1 class="text-6xl md:text-8xl font-bold text-primary mb-4">404</h1>
      <p class="text-xl md:text-2xl font-bold text-text-primary mb-4">Seite nicht gefunden</p>
      <p class="text-text-secondary mb-8">Die angeforderte Seite existiert nicht oder wurde verschoben.</p>
      <a href="/" class="inline-flex items-center gap-2 px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 shadow-lg">
        <i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>
        Zurück zur Startseite
      </a>
    </div>
  </main>
</Layout>
