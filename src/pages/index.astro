---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import About from '../components/sections/About.astro';
import PartnerLogos from '../components/sections/PartnerLogos.astro';
import Process from '../components/sections/Process.astro';
import Services from '../components/sections/Services.astro';
import TrackingQuality from '../components/sections/TrackingQuality.astro';
import Gallery from '../components/sections/Gallery.astro';
import Pricing from '../components/sections/Pricing.astro';
import FAQ from '../components/sections/FAQ.astro';
---

<Layout
  title="Verteilservice Plus | Flyerverteilung & Streetpromotion bundesweit"
  description="Professionelle Haus-zu-Haus-Verteilung mit Live-App-Tracking, Fotodokumentation und eigener Qualitätskontrolle. Bundesweit seit über 20 Jahren."
>
  <main>
    <Hero />
    <TrustBar />
    <About />
    <PartnerLogos />
    <Process />
    <Services />
    <TrackingQuality />
    <Gallery />
    <Pricing />
    <FAQ />
  </main>
</Layout>
