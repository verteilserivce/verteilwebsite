---
import Layout from '../layouts/Layout.astro';
import Bullseye from '../components/icons/Bullseye.astro';
import ShieldCheck from '../components/icons/ShieldCheck.astro';
import Phone from '../components/icons/Phone.astro';
import Envelope from '../components/icons/Envelope.astro';
import MapMarker from '../components/icons/MapMarker.astro';
import WhatsApp from '../components/icons/WhatsApp.astro';
import Check from '../components/icons/Check.astro';
import aboutStory1 from '../assets/images/überuns.jpeg';
import aboutStory2 from '../assets/images/überuns2.jpeg';
import aboutContact from '../assets/images/warumwir.jpeg';

const values = [
  {
    title: 'Zielgenauigkeit',
    description: 'Jeder Flyer hat einen bestimmten Empfänger. Wir stellen sicher, dass er genau dort ankommt, wo er die größte Wirkung entfaltet.',
    icon: Bullseye,
  },
  {
    title: 'Zuverlässigkeit',
    description: 'Wir halten unsere Zusagen ein – termingerecht, gründlich und mit höchster Sorgfalt. Vertrauen ist das Fundament unseres Geschäfts.',
    icon: ShieldCheck,
  },
];

const stats = [
  { value: '20+', label: 'Jahre Erfahrung' },
  { value: 'Bundesweit', label: 'In ganz Deutschland' },
  { value: '100%', label: 'Haus-zu-Haus-Fokus' },
  { value: 'Marktführer', label: 'Als Kunden' },
];

const services = [
  'Flyerverteilung',
  'Prospektverteilung',
  'Zeitungsverteilung',
  'Beilagenverteilung',
  'Adressierte Werbung',
  'Direktmarketing',
  'Streetpromotion & Promotion-Aktionen',
];

const trackingFeatures = [
  'Live-App-Tracking unserer Verteiler',
  'GPS-Standortüberwachung in Echtzeit',
  'Fotodokumentation der Verteilgebiete',
  'Kontrolle durch eigene Kontrolleure',
  'Zusätzliche Überwachung durch Bezirksleiter',
];

const audiences = [
  'Lokale Unternehmen',
  'Franchise-Betriebe',
  'Große Firmen',
  'Dienstleister',
  'Promotion- und Werbekampagnen',
];
---

<Layout
  title="Über Uns | Verteilservice Plus"
  description="Seit über 20 Jahren Ihr Partner für Flyerverteilung, Prospektverteilung & Streetpromotion in ganz Deutschland. Mit Live-Tracking & Qualitätskontrolle."
>
  <main>
    {/* Hero */}
    <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-background-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <span class="inline-block text-sm font-bold uppercase tracking-widest text-primary mb-4">Über Uns</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-6 leading-tight">
            Ihr bundesweiter Partner für professionelle Werbeverteilung
          </h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
            Seit über 20 Jahren stehen wir für exzellente Planung, lückenlose Kontrolle und messbare Ergebnisse – bundesweit in ganz Deutschland.
          </p>
        </div>
      </div>
    </section>

    {/* Intro + Story */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
              Über uns
            </h2>
            <div class="space-y-4 text-text-secondary leading-relaxed">
              <p class="text-lg">
                Verteilservice Plus steht für professionelle, zuverlässige und moderne Haus-zu-Haus-Verteilung sowie erfolgreiche Streetpromotion – bundesweit in ganz Deutschland.
              </p>
              <p>
                Hinter unserem Unternehmen steht ein erfahrenes Team mit langjähriger Erfahrung in der Werbeverteilung, Direktwerbung und Promotionplanung. Gemeinsam mit unseren geschulten Innen- und Außendienstteams setzen wir Kampagnen jeder Größenordnung präzise, strukturiert und professionell um.
              </p>
              <p>
                Ob lokale Verteilaktionen, regionale Kampagnen oder bundesweite Promotion – wir entwickeln individuelle Lösungen passend zu Ihrem Unternehmen, Ihrer Zielgruppe und Ihrem Verteilgebiet.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="aspect-[3/4] rounded-2xl bg-gray-200 overflow-hidden">
              <img
                src={aboutStory1.src}
                alt="Verteilservice Plus bei der Arbeit"
                class="w-full h-full object-cover"
                loading="eager"
                width="250"
                height="333"
              />
            </div>
            <div class="aspect-[3/4] rounded-2xl bg-gray-200 overflow-hidden mt-8">
              <img
                src={aboutStory2.src}
                alt="Qualitätskontrolle bei der Verteilung"
                class="w-full h-full object-cover"
                loading="eager"
                width="250"
                height="333"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Strong Structure */}
    <section class="py-20 md:py-28 bg-background-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Ein starkes Unternehmen mit klarer Struktur
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed">
            Unsere Stärke liegt in der Kombination aus professioneller Planung, zuverlässiger Durchführung und moderner Kontrolle.
          </p>
        </div>
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-text-secondary leading-relaxed mb-4">
            Während unsere Außendienst- und Verteilerteams täglich für eine saubere und zuverlässige Zustellung sorgen, plant und koordiniert unser Büro jede Kampagne bis ins kleinste Detail.
          </p>
          <p class="text-text-secondary leading-relaxed">
            Von der ersten Planung bis zur letzten verteilten Straße greift bei uns jeder Bereich perfekt ineinander.
          </p>
        </div>
      </div>
    </section>

    {/* Precise Planning */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Präzise Planung bis zur letzten Straße
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed">
            Eine erfolgreiche Verteilung beginnt lange vor der eigentlichen Zustellung.
          </p>
        </div>
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-text-secondary leading-relaxed">
            Deshalb erstellen wir für jede Kampagne detaillierte Verteil- und Gebietsplanungen, bei denen jede Straße, jedes Wohngebiet und jedes gewünschte Haus berücksichtigt wird. Durch unsere strukturierte Arbeitsweise gewährleisten wir eine effiziente, nachvollziehbare und kontrollierte Durchführung aller Aufträge.
          </p>
        </div>
      </div>
    </section>

    {/* Nationwide Distribution */}
    <section class="py-20 md:py-28 bg-background-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Bundesweite Verteilung & Streetpromotion
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed mb-8">
            Wir bieten bundesweit professionelle Lösungen in den Bereichen:
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            {services.map((service) => (
              <span class="inline-flex items-center px-4 py-2 text-sm font-medium text-text-secondary bg-white border border-border rounded-full">
                {service}
              </span>
            ))}
          </div>
          <p class="mt-8 text-text-secondary leading-relaxed">
            Ob kleine lokale Aktion oder groß angelegte Kampagne – wir unterstützen Unternehmen jeder Größe bei einer erfolgreichen Werbeverteilung.
          </p>
        </div>
      </div>
    </section>

    {/* Modern Control */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Moderne Kontrolle & maximale Transparenz
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed">
            Qualität, Kontrolle und Transparenz stehen bei uns an erster Stelle.
          </p>
        </div>
        <div class="max-w-3xl mx-auto">
          <p class="text-text-secondary leading-relaxed text-center mb-8">
            Deshalb arbeiten wir mit modernen Tracking- und Kontrollsystemen, um jede laufende Verteilung nachvollziehbar und überprüfbar zu machen. Unsere Leistungen umfassen unter anderem:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
            {trackingFeatures.map((feature) => (
              <div class="flex items-center gap-3 bg-background-alt rounded-2xl px-5 py-4">
                <span class="w-6 h-6 flex items-center justify-center rounded-full bg-primary/10 text-primary shrink-0">
                  <Check class="w-3.5 h-3.5" />
                </span>
                <span class="text-sm font-medium text-text-secondary">{feature}</span>
              </div>
            ))}
          </div>
          <p class="mt-8 text-text-secondary leading-relaxed text-center">
            Dadurch schaffen wir maximale Transparenz und zusätzliche Sicherheit für unsere Kunden.
          </p>
        </div>
      </div>
    </section>

    {/* Trust */}
    <section class="py-20 md:py-28 bg-background-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Vertrauen durch professionelle Arbeitsweise
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed">
            Unsere strukturierte Organisation, unsere zuverlässigen Teams und unsere professionelle Umsetzung sind die Gründe, warum uns Unternehmen aus unterschiedlichsten Branchen ihr Vertrauen schenken.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto mb-8">
          {audiences.map((audience) => (
            <span class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-text-secondary bg-white border border-border rounded-full">
              {audience}
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* Our Goal */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
          Unser Ziel
        </h2>
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-8">
          Unser Ziel ist es, Werbung nicht nur zu verteilen, sondern sichtbar, kontrollierbar und erfolgreich zu machen.
        </p>
        <p class="text-text-secondary leading-relaxed mb-10">
          Mit Verteilservice Plus erhalten Sie einen zuverlässigen Partner für professionelle Werbeverteilung und moderne Promotion-Lösungen in ganz Deutschland.
        </p>
        <a
          href="/kontakt#angebot"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5"
        >
          Jetzt unverbindlich anfragen
        </a>
      </div>
    </section>

    {/* Values */}
    <section class="py-20 md:py-28 bg-[#F8F7F5]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="inline-block text-sm font-bold uppercase tracking-widest text-primary mb-4">Unsere Werte</span>
          <h2 class="text-3xl md:text-4xl font-bold text-text-primary">
            Was uns antreibt
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {values.map((value) => (
            <div class="bg-white rounded-3xl p-8 shadow-sm">
              <div class="w-12 h-12 flex items-center justify-center rounded-full bg-primary/10 text-primary mb-6">
                <value.icon class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-3">{value.title}</h3>
              <p class="text-text-secondary leading-relaxed">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Stats */}
    <section class="py-16 md:py-20 bg-text-primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {stats.map((stat) => (
            <div class="text-center">
              <p class="text-3xl md:text-4xl font-bold text-primary mb-2">{stat.value}</p>
              <p class="text-sm text-gray-400 uppercase tracking-wider">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Contact Teaser */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <span class="inline-block text-sm font-bold uppercase tracking-widest text-primary mb-4">Kontakt</span>
            <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
              Sprechen Sie uns an
            </h2>
            <p class="text-text-secondary leading-relaxed mb-8">
              Ob per Telefon, E-Mail oder WhatsApp – wir sind für Sie da. Lassen Sie uns gemeinsam besprechen,
              wie wir Ihre Werbebotschaft am besten in die Welt bringen.
            </p>
            <div class="space-y-4">
              <a href="tel:+491638866766" class="flex items-center gap-4 text-text-secondary hover:text-primary transition-colors">
                <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                  <Phone class="w-5 h-5" />
                </span>
                <span class="font-medium">0163 8866766</span>
              </a>
              <a href="mailto:Info@verteilservice-plus.de" class="flex items-center gap-4 text-text-secondary hover:text-primary transition-colors">
                <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                  <Envelope class="w-5 h-5" />
                </span>
                <span class="font-medium">Info@verteilservice-plus.de</span>
              </a>
              <a href="https://wa.me/491638866766" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-text-secondary hover:text-primary transition-colors">
                <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                  <WhatsApp class="w-5 h-5" />
                </span>
                <span class="font-medium">WhatsApp</span>
              </a>
              <div class="flex items-center gap-4 text-text-secondary">
                <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                  <MapMarker class="w-5 h-5" />
                </span>
                <span class="font-medium">Kupferhammer weg 51, 61440 Oberursel</span>
              </div>
            </div>
          </div>
          <div class="aspect-[4/3] rounded-3xl bg-gray-200 overflow-hidden">
            <img
              src={aboutContact.src}
              alt="Verteilservice Plus Team"
              class="w-full h-full object-cover"
              loading="lazy"
              width="800"
              height="600"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
