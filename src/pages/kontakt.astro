---
import Layout from '../layouts/Layout.astro';
import Phone from '../components/icons/Phone.astro';
import Envelope from '../components/icons/Envelope.astro';
import MapMarker from '../components/icons/MapMarker.astro';
import WhatsApp from '../components/icons/WhatsApp.astro';
import Check from '../components/icons/Check.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
---

<Layout
  title="Kontakt | Verteilservice Plus"
  description="Kontaktieren Sie Verteilservice Plus für Ihr individuelles Angebot. Telefon: 0163 8866766. Bundesweite Flyerverteilung & Streetpromotion."
>
  <main>
    {/* Hero */}
    <section class="pt-20 pb-16 md:pt-28 md:pb-24 bg-background-alt">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <span class="inline-block text-sm font-bold uppercase tracking-widest text-primary mb-4">Kontakt</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-6 leading-tight">
            Jetzt unverbindliches Angebot anfragen
          </h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
            Rufen Sie uns an, schreiben Sie eine E-Mail oder nutzen Sie das Kontaktformular – wir melden uns schnellstmöglich bei Ihnen.
          </p>
        </div>
      </div>
    </section>

    {/* Contact Section */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
          {/* Left: Contact Info */}
          <div class="lg:col-span-2">
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-6">
              Direkter Kontakt
            </h2>
            <p class="text-text-secondary leading-relaxed mb-10">
              Wir freuen uns auf Ihre Nachricht. Egal ob Sie ein konkretes Angebot wünschen oder erst einmal unverbindlich beraten werden möchten – wir sind für Sie da.
            </p>

            <div class="space-y-6">
              <a href="tel:+491638866766" class="group flex items-start gap-4">
                <span class="w-12 h-12 flex items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-200">
                  <Phone class="w-5 h-5" />
                </span>
                <div>
                  <p class="text-sm text-text-muted mb-0.5">Telefon</p>
                  <p class="text-base font-semibold text-text-primary group-hover:text-primary transition-colors">0163 8866766</p>
                </div>
              </a>

              <a href="mailto:Info@verteilservice-plus.de" class="group flex items-start gap-4">
                <span class="w-12 h-12 flex items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-200">
                  <Envelope class="w-5 h-5" />
                </span>
                <div>
                  <p class="text-sm text-text-muted mb-0.5">E-Mail</p>
                  <p class="text-base font-semibold text-text-primary group-hover:text-primary transition-colors break-all">Info@verteilservice-plus.de</p>
                </div>
              </a>

              <a href="https://wa.me/491638866766" target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4">
                <span class="w-12 h-12 flex items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-200">
                  <WhatsApp class="w-5 h-5" />
                </span>
                <div>
                  <p class="text-sm text-text-muted mb-0.5">WhatsApp</p>
                  <p class="text-base font-semibold text-text-primary group-hover:text-primary transition-colors">Direktnachricht senden</p>
                </div>
              </a>

              <div class="flex items-start gap-4">
                <span class="w-12 h-12 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                  <MapMarker class="w-5 h-5" />
                </span>
                <div>
                  <p class="text-sm text-text-muted mb-0.5">Adresse</p>
                  <p class="text-base font-semibold text-text-primary">Kupferhammer weg 51</p>
                  <p class="text-base font-semibold text-text-primary">61440 Oberursel</p>
                </div>
              </div>
            </div>
          </div>

          {/* Right: Contact Form */}
          <div class="lg:col-span-3">
            <div class="bg-[#F8F7F5] rounded-3xl p-8 md:p-10">
              {/* Success Message */}
              <div id="form-success" class="hidden text-center py-10" role="status" aria-live="polite">
                <div class="w-16 h-16 mx-auto mb-6 flex items-center justify-center rounded-full bg-green-100 text-green-600">
                  <Check class="w-8 h-8" />
                </div>
                <h3 class="text-2xl font-bold text-text-primary mb-3">Vielen Dank für Ihre Nachricht!</h3>
                <p class="text-text-secondary">Wir haben Ihre Anfrage erhalten und melden uns innerhalb von 24 Stunden bei Ihnen.</p>
              </div>

              {/* Form */}
              <form
                id="contact-form"
                action="https://api.web3forms.com/submit"
                method="POST"
                class="space-y-6"

              >
                <input type="hidden" name="access_key" value={accessKey} />
                <input type="hidden" name="subject" value="Neue Anfrage über Verteilservice Plus Website" />
                <input type="hidden" name="from_name" value="Verteilservice Plus Website" />
                <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="name" class="block text-sm font-medium text-text-primary mb-2">Name *</label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="w-full px-4 py-3 bg-white border border-border rounded-xl text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                      placeholder="Ihr vollständiger Name"
                      maxlength="100"
                    />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-text-primary mb-2">E-Mail *</label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full px-4 py-3 bg-white border border-border rounded-xl text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                      placeholder="ihre@email.de"
                      maxlength="254"
                    />
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="phone" class="block text-sm font-medium text-text-primary mb-2">Telefon</label>
                    <input
                      type="tel"
                      id="phone"
                      name="telefon"
                      class="w-full px-4 py-3 bg-white border border-border rounded-xl text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                      placeholder="Optional"
                      maxlength="30"
                    />
                  </div>
                  <div>
                    <label for="subject-select" class="block text-sm font-medium text-text-primary mb-2">Betreff *</label>
                    <select
                      id="subject-select"
                      name="betreff"
                      required
                      class="w-full px-4 py-3 bg-white border border-border rounded-xl text-text-primary focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors"
                    >
                      <option value="" disabled selected>Betreff auswählen</option>
                      <option value="Flyerverteilung">Flyerverteilung</option>
                      <option value="Prospektverteilung">Prospektverteilung</option>
                      <option value="Zeitungs- & Beilagenverteilung">Zeitungs- & Beilagenverteilung</option>
                      <option value="Direktwerbung">Direktwerbung</option>
                      <option value="Streetpromotion">Streetpromotion</option>
                      <option value="Sampling Aktionen">Sampling Aktionen</option>
                      <option value="Bundesweite Kampagnenplanung">Bundesweite Kampagnenplanung</option>
                      <option value="Adressierte Verteilung">Adressierte Verteilung</option>
                      <option value="Web- & Logo Design">Web- & Logo Design</option>
                      <option value="Sonstiges">Sonstiges</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label for="message" class="block text-sm font-medium text-text-primary mb-2">Nachricht *</label>
                  <textarea
                    id="message"
                    name="nachricht"
                    rows="5"
                    required
                    class="w-full px-4 py-3 bg-white border border-border rounded-xl text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors resize-none"
                    placeholder="Beschreiben Sie Ihr Vorhaben – Auflage, Gebiet, Zeitrahmen..."
                    maxlength="2000"
                  ></textarea>
                </div>

                <div class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    id="privacy"
                    name="privacy"
                    required
                    class="w-5 h-5 mt-0.5 rounded border-border text-primary focus:ring-primary"
                  />
                  <label for="privacy" class="text-sm text-text-secondary leading-relaxed">
                    Ich habe die <a href="/datenschutz" class="text-primary hover:underline">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu. *
                  </label>
                </div>

                <button
                  type="submit"
                  id="submit-btn"
                  class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-white bg-primary hover:bg-primary-dark rounded-full transition-all duration-200 shadow-lg shadow-primary/20 hover:shadow-primary/30 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span id="btn-text">Nachricht senden</span>
                  <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </button>

                <p id="form-error" class="hidden text-sm text-red-600 text-center" role="alert" aria-live="assertive"></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  (function() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    if (!form || !successMsg || !errorMsg || !submitBtn || !btnText || !btnSpinner) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.add('hidden');
      errorMsg.textContent = '';

      // Client validation
      const requiredFields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input[required], textarea[required], select[required]');
      let isValid = true;

      requiredFields.forEach((field) => {
        if (!field.value.trim()) {
          isValid = false;
          field.classList.add('border-red-400');
          field.setAttribute('aria-invalid', 'true');
        } else {
          field.classList.remove('border-red-400');
          field.setAttribute('aria-invalid', 'false');
        }
      });

      // Email validation
      const emailField = form.querySelector<HTMLInputElement>('input[type="email"]');
      if (emailField && emailField.value) {
        const emailRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
        if (!emailRegex.test(emailField.value)) {
          isValid = false;
          emailField.classList.add('border-red-400');
          emailField.setAttribute('aria-invalid', 'true');
        } else {
          emailField.setAttribute('aria-invalid', 'false');
        }
      }

      if (!isValid) {
        errorMsg.textContent = 'Bitte füllen Sie alle Pflichtfelder korrekt aus.';
        errorMsg.classList.remove('hidden');
        errorMsg.focus();
        return;
      }

      // Loading state
      submitBtn.disabled = true;
      btnText.textContent = 'Wird gesendet...';
      btnSpinner.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          signal: controller.signal,
        });
        clearTimeout(timeoutId);
        const data = await response.json();

        if (data.success) {
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error(data.message || 'Ein Fehler ist aufgetreten.');
        }
      } catch (err) {
        if (err instanceof Error && err.name === 'AbortError') {
          errorMsg.textContent = 'Die Anfrage hat zu lange gedauert. Bitte versuchen Sie es später erneut.';
        } else {
          errorMsg.textContent = err instanceof Error ? err.message : 'Ein Fehler ist aufgetreten. Bitte versuchen Sie es später erneut.';
        }
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Nachricht senden';
        btnSpinner.classList.add('hidden');
      }
    });

    // Remove error styles on input
    form.querySelectorAll('input, textarea, select').forEach((field) => {
      field.addEventListener('input', () => {
        field.classList.remove('border-red-400');
      });
    });
  })();
</script>
